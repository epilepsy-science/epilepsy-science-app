{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nuxt-dev",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "nuxt-dev-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "[ -f env_var.sh ] && . ./env_var.sh; unset CTF_SPACE_ID; exec ./node_modules/.bin/nuxt dev --port 3001"
      ],
      "port": 3001
    }
  ]
}
