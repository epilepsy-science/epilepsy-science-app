{
  "pennepi_person.parquet": {
    "rows": 100,
    "description": "Patient demographics",
    "columns": {
      "person_id": "string",
      "dataset_name": "string",
      "institutionname": "string",
      "sex": "string (Male/Female)",
      "species": "string",
      "population": "string (adult)",
      "id": "string (UUID)"
    }
  },
  "pennepi_ieeg_recording_parameters.parquet": {
    "rows": 100,
    "description": "iEEG recording parameters and equipment details",
    "columns": {
      "person_id": "string",
      "dataset_name": "string",
      "session_id": "string",
      "age_ieegimplant": "string (numeric)",
      "samplingfrequency": "string (numeric)",
      "recordingduration": "string (numeric, ms)",
      "recordingtype": "string (discontinuous)",
      "ieeg_isfocal": "string (focal/nonfocal)",
      "ecogchannelcount": "string (numeric)",
      "seegchannelcount": "string (numeric)",
      "eegchannelcount": "string (numeric)",
      "ecgchannelcount": "string (numeric)",
      "emgchannelcount": "string (numeric)",
      "eogchannelcount": "string (numeric)",
      "miscchannelcount": "string (numeric)",
      "triggerchannelcount": "string (numeric)",
      "manufacturer": "string",
      "manufacturermodelname": "string",
      "electrodemanufacturer": "string",
      "institutionname": "string",
      "powerlinefrequency": "string (numeric)",
      "ieegground": "string",
      "ieegreference": "string",
      "taskname": "string",
      "taskdescription": "string",
      "id": "string (UUID)"
    }
  },
  "pennepi_intervention.parquet": {
    "rows": 100,
    "description": "Surgical interventions and seizure outcomes",
    "columns": {
      "person_id": "string",
      "dataset_name": "string",
      "session_id": "string",
      "age_intervention": "string (numeric)",
      "intervention_type": "string (ablation/resection/medication/RNS/VNS/DBS)",
      "intervention_side": "string (Left/Right/Bilateral/n/a)",
      "intervention_location": "string",
      "seizure_engel12m": "string (Engel score at 12 months)",
      "seizure_engel24m": "string (Engel score at 24 months)",
      "id": "string (UUID)"
    }
  },
  "pennepi_mri.parquet": {
    "rows": 67,
    "description": "MRI scan findings",
    "columns": {
      "person_id": "string",
      "dataset_name": "string",
      "session_id": "string",
      "age_at_scan": "string (numeric)",
      "mri_lesion": "string (lesional/nonlesional)",
      "mri_lesiontype": "string (FCD/MTS/Other/PVNH/Tubers/Encephalocele/Multiple/Prior surgery/n/a)",
      "mri_lesiondetails": "string",
      "id": "string (UUID)"
    }
  },
  "pennepi_5sense.parquet": {
    "rows": 64,
    "description": "5-SENSE seizure prediction scores",
    "columns": {
      "person_id": "string",
      "dataset_name": "string",
      "session_id": "string",
      "fivesensescore": "string (numeric, 0-1)",
      "id": "string (UUID)"
    }
  }
}
